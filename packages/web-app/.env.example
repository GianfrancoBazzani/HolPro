DATABASE_URL=mysql://user:password@localhost:3306/holpro
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
RESEND_API_KEY=
EMAIL_FROM=HolPro <hello@holpro.health>
# Comma-separated IPs or CIDR ranges of the reverse proxies in front of the app.
TRUSTED_PROXIES=

# Assistant: server-side model, voice and single-process mock backend
OPENAI_API_KEY=
ASSISTANT_MODEL=openai/gpt-5.4-mini
ASSISTANT_TITLE_MODEL=openai/gpt-5.4-mini
ASSISTANT_VOICE_SPEAKER=alloy
MOCK_TASK_DURATION_MS=120000
# Optional absolute path to a workspace containing skills/
ASSISTANT_SKILLS_DIR=

# Private MCP signing key: generate with openssl rand -base64 32
MCP_TOKEN_SECRET=

# Optional Telegram assistant. Leave the token empty to disable.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET_TOKEN=
TELEGRAM_MODE=webhook

# Durable onboarding jobs run in the long-lived Node server.
ONBOARDING_WORKER_ENABLED=true
# Set true to send coaching updates through the existing Resend configuration.
ONBOARDING_EMAIL_ENABLED=false
# Browser push: generate VAPID keys once; retain the private key securely.
WEB_PUSH_SUBJECT=mailto:hello@holpro.health
WEB_PUSH_PUBLIC_KEY=
WEB_PUSH_PRIVATE_KEY=
