# Web app
PORT=5000
DATABASE_URL=mysql://holpro:change-me@database:3306/holpro
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=
RESEND_API_KEY=
EMAIL_FROM=HolPro <hello@auth.holpro.health>
# Comma-separated IPs or CIDR ranges of the reverse proxies in front of the app.
TRUSTED_PROXIES=

# Database
MYSQL_ROOT_PASSWORD=change-me-too
MYSQL_USER=holpro
MYSQL_PASSWORD=change-me
MYSQL_DATABASE=holpro
MYSQL_PORT=3306

# Assistant: server-side model, voice and single-process mock backend
OPENAI_API_KEY=
ASSISTANT_MODEL=openai/gpt-5.4-mini
ASSISTANT_VOICE_SPEAKER=alloy
MOCK_TASK_DURATION_MS=120000
# Optional absolute path to a workspace containing skills/
ASSISTANT_SKILLS_DIR=

# Private MCP signing key: generate with openssl rand -base64 32
MCP_TOKEN_SECRET=

# Optional Telegram assistant (one bot and one process per deployment).
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET_TOKEN=
TELEGRAM_MODE=webhook
